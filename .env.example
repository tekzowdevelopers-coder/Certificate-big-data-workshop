# =================================================================
# RRCE Workshop Portal - Environment Variables Configuration
# =================================================================

# 1. MongoDB Atlas Connection URI (Required for Vercel Deployment)
# Create a free M0 cluster on MongoDB Atlas (https://www.mongodb.com/atlas)
# Replace <username>, <password>, and <cluster-url> with your credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rrce_workshop?retryWrites=true&w=majority

# 2. JWT Authentication Secret for Admin Sessions
JWT_SECRET=rrce-bigdata-hadoop-workshop-jwt-secret-2026-secure-key

# 3. Server Port (Local development default: 5000)
PORT=5000
